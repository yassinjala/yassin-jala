  <!-- SCRIPT LIBRARIES -->
<script src='https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js'/>
<script src='https://cdn.jsdelivr.net/npm/theia-sticky-sidebar@1.7.0/dist/theia-sticky-sidebar.min.js'/>
<script type='text/javascript'>
  
//<![CDATA[
jQuery(document).ready(function($) {
    // --- Global Scope Functions ---

    // 1. Lazy Loading Function
    function lazyLoadImages() {
        $('.entry-image, .author-avatar').each(function() {
            var $this = $(this);
            if ($this.is(":visible") && !$this.hasClass('almosaitiron-lazy')) {
                var imageUrl = $this.data('image');
                if (imageUrl) {
                    var image = new Image();
                    image.onload = function() { $this.css('background-image', 'url(' + imageUrl + ')').addClass('almosaitiron-lazy'); };
                    image.src = imageUrl;
                }
            }
        });
    }

    // 2. Shortcode System Function
    function processShortcodes() {
        $('[data-shortcode*="getPosts"]').each(function() {
            var $widget = $(this);
            var shortcode = $widget.data('shortcode');

            if ($widget.data('loaded')) return;
            $widget.data('loaded', true).html('<div class="loader"></div>');

            var settings = {};
            var options = shortcode.split('$').slice(1);
            options.forEach(function(option) {
                var parts = option.split('=');
                if (parts.length === 2) {
                    settings[parts[0].trim()] = parts[1].replace(/[{}]/g, '').trim();
                }
            });

            var count = settings.results || 5;
            var label = settings.label || false;
            var style = settings.style || '1';
            var type = settings.type || 'posts';
            var noThumbnail = (typeof window.noThumbnail !== 'undefined') ? window.noThumbnail : 'https://resources.blogblog.com/img/blank.gif';

            var feedUrl = "/feeds/";
            if (type === 'comments') {
                feedUrl += "comments/default";
            } else {
                feedUrl += "posts/default";
                if (label && label !== 'recent') {
                    feedUrl += "/-/" + encodeURIComponent(label);
                }
            }
            feedUrl += "?alt=json-in-script&max-results=" + count + "&callback=?";

            $.getJSON(feedUrl, function(data) {
                var html = '';
                var entries = data.feed.entry || [];

                if (entries.length === 0) {
                    $widget.html('<div class="error-msg">لا توجد مقالات لعرضها.</div>');
                    return;
                }

                for (var i = 0; i < entries.length; i++) {
                    var entry = entries[i];
                    var postUrl, postTitle, postImage, postDate, postSnippet;

                    if (type === 'comments') {
                        for (var l = 0; l < entry.link.length; l++) {
                            if (entry.link[l].rel === 'alternate') { postUrl = entry.link[l].href; break; }
                        }
                        postTitle = entry.author[0].name.$t;
                        postImage = 'https://www.gravatar.com/avatar/?d=mm&s=70';
                        if (entry.author[0].gd$image && entry.author[0].gd$image.src) {
                            postImage = entry.author[0].gd$image.src.replace('/s1600/', '/s72-c/');
                        }
                        postSnippet = entry.content.$t;
                        html += '<div class="cmm1-items"><a class="entry-inner" href="' + postUrl + '"><div class="entry-image-wrap"><span class="entry-image" data-image="' + postImage + '"></span></div><div class="entry-header"><h2 class="entry-title">' + postTitle + '</h2><p class="cmm-snippet">' + postSnippet.substring(0, 50) + '...</p></div></a></div>';
                    } else {
                        for (var k = 0; k < entry.link.length; k++) {
                            if (entry.link[k].rel === 'alternate') { postUrl = entry.link[k].href; break; }
                        }
                        postTitle = entry.title.$t;
                        var date = new Date(entry.published.$t);
                        postDate = date.toLocaleDateString();
                        postImage = noThumbnail;
                        if ("media$thumbnail" in entry) {
                            postImage = entry.media$thumbnail.url.replace('/s72-c/', '/w400-h280-c/');
                        }
                        
                        if (style === '1') {
                             if (i === 0) { html += '<div class="side3-items">'; }
                             html += '<div class="side3-item"><a class="entry-image-wrap" href="' + postUrl + '"><span class="entry-image" data-image="' + postImage + '"></span></a><div class="entry-header"><h2 class="entry-title"><a href="' + postUrl + '">' + postTitle + '</a></h2><div class="entry-meta"><time class="published">' + postDate + '</time></div></div></div>';
                             if (i === entries.length - 1) { html += '</div>'; }
                        } else if (style === '2') {
                             if (i === 0) { html += '<div class="side-items">'; }
                             html += '<div class="side-item"><a class="entry-image-wrap" href="' + postUrl + '"><span class="entry-image" data-image="' + postImage + '"></span></a><div class="entry-header"><h2 class="entry-title"><a href="' + postUrl + '">' + postTitle + '</a></h2><div class="entry-meta"><time class="published">' + postDate + '</time></div></div></div>';
                             if (i === entries.length - 1) { html += '</div>'; }
                        }
                    }
                }

                $widget.html(html);
                lazyLoadImages();
            }).fail(function() {
                $widget.html('<div class="error-msg">حدث خطأ أثناء تحميل المقالات.</div>');
            });
        });
    }

    // الكود الرئيسي الذي يتم تنفيذه بعد تحميل الصفحة
    var mobileMenuWidget = null;
    $('.widget.LinkList').each(function() {
        var widgetTitle = $(this).find('h3.title').text().trim();
        if (widgetTitle === 'القائمة الخاصة بالهاتف') {
            mobileMenuWidget = $(this);
        }
    });

    if (mobileMenuWidget && mobileMenuWidget.length) {
        var mobileMenuLinks = mobileMenuWidget.find('ul').clone();
        $('#mobile-menu').append(mobileMenuLinks);
    } else {
        $('#almosaitiron-pro-main-nav-menu').clone().removeAttr('id').appendTo('#mobile-menu');
    }

    processShortcodes();
    $('#almosaitiron-pro-main-nav ul > li').on('mouseenter', function() { $(this).children('ul, .ul').stop(true, true).show(); }).on('mouseleave', function() { $(this).children('ul, .ul').stop(true, true).hide(); });
    if (typeof(fixedSidebar) === 'undefined' || fixedSidebar !== false) {
        $('#sidebar-wrapper').theiaStickySidebar({ additionalMarginTop: 30, additionalMarginBottom: 30 });
    }
    lazyLoadImages();
    $(window).on('scroll', lazyLoadImages);
    $('.search-toggle.show-search').on('click', function(e) { e.preventDefault(); $('#main-search-wrap').fadeIn(); });
    $('.search-toggle.search-close').on('click', function(e) { e.preventDefault(); $('#main-search-wrap').fadeOut(); });
    $('.mobile-menu-toggle').on('click', function(e) { e.preventDefault(); $('body').addClass('nav-active'); });
    $('.overlay, .hide-mobile-menu').on('click', function(e) { e.preventDefault(); $('body').removeClass('nav-active'); });
    $(window).on('scroll', function() { if ($(this).scrollTop() > 300) { $('#back-top').addClass('show'); } else { $('#back-top').removeClass('show'); } });
    $('#back-top').on('click', function(e) { e.preventDefault(); $('html, body').animate({scrollTop: 0}, 500); });
    
    var ticker = $('.ticker-items');
    if (ticker.length > 0) {
        var tickerItems = ticker.find('.ticker-item'), currentIndex = 0, interval;
        function showNextItem() {
            tickerItems.removeClass('active');
            $(tickerItems[currentIndex]).addClass('active');
            currentIndex = (currentIndex + 1) % tickerItems.length;
        }
        function startTicker() {
            clearInterval(interval);
            interval = setInterval(showNextItem, 5000);
        }
        $('.almosaitiron-ticker--next').on('click', function(e) { e.preventDefault(); showNextItem(); startTicker(); });
        $('.almosaitiron-ticker--prev').on('click', function(e) { e.preventDefault(); currentIndex = (currentIndex - 2 + tickerItems.length) % tickerItems.length; showNextItem(); startTicker(); });
        if (tickerItems.length > 0) { showNextItem(); startTicker(); }
    }
    
    (function() {
        var a = $('.darkmode-toggle'), b = $('html'), c = 'is-dark';
        if (localStorage.getItem('dark-mode') === 'true') { b.addClass(c); }
        a.on('click', function(e) {
            e.preventDefault();
            b.toggleClass(c);
            localStorage.setItem('dark-mode', b.hasClass(c));
        });
    })();
    
    if ($('body').hasClass('is-post')) {
        var tocContainer = $('#post-body'), headings = tocContainer.find('h2, h3, h4');
        if (headings.length > 1) {
            var tocList = $('<ol/>');
            headings.each(function(i) {
                var h = $(this), hText = h.text(), hId = 'toc-' + i;
                h.attr('id', hId);
                tocList.append($('<li><a href="#' + hId + '">' + hText + '</a></li>'));
            });
            var tocWrapper = $('<div class="almosaitiron-toc-wrap"><div class="almosaitiron-toc-inner"><a class="almosaitiron-toc-title" href="#"><span class=almosaitiron-toc-title-text">جدول المحتويات</span></a><div id="almosaitiron-toc" style="display:none;"></div></div></div>');
            tocWrapper.find('#almosaitiron-toc').append(tocList);
            tocContainer.prepend(tocWrapper);
            $('.almosaitiron-toc-title').on('click', function(e) { e.preventDefault(); $(this).toggleClass('is-expanded').siblings('#almosaitiron-toc').slideToggle('fast'); });
        }
    }
    
    if ($('body').is('.is-post')) {
        var progressBar = $('#progress-bar');
        var totalHeight = $('body').height() - $(window).height();
        $(window).on('scroll', function() {
            var progress = ($(window).scrollTop() / totalHeight) * 100;
            progressBar.css('width', progress + '%');
        });
    }
    
    if ($('#reading-time').length) {
        var text = $('#post-body').text();
        var words = text.trim().split(/\s+/).length;
        var time = Math.ceil(words / 200);
        $('#reading-time').text(time + ' دقيقة للقراءة');
    }
    
    $('pre').each(function(){
        var copyButton = $('<button class="copy-code-button">نسخ</button>');
        $(this).append(copyButton);
        copyButton.on('click', function(){
            var code = $(this).siblings('code').text() || $(this).parent().text().replace('نسخ','');
            navigator.clipboard.writeText(code);
            $(this).text('تم النسخ!').addClass('copied');
            setTimeout(function(){ copyButton.text('نسخ').removeClass('copied'); }, 2000);
        });
    });
    
    if ($('#post-reactions').length) {
        var reactions = ['👍', '❤️', '😂', '😯', '😢', '😡'];
        var reactionHTML = '<h4>ما هو شعورك تجاه هذا المقال؟</h4>';
        reactions.forEach(function(r) {
            reactionHTML += '<span class="reaction-button" title="'+r+'">' + r + '<span class="reaction-count">0</span></span>';
        });
        $('#post-reactions').html(reactionHTML);
        $('.reaction-button').on('click', function() {
            if(!$(this).hasClass('disabled')) {
                var count = $(this).find('.reaction-count');
                count.text(parseInt(count.text()) + 1);
                $('.reaction-button').addClass('disabled');
            }
        });
    }
});
//]]>
  
</script>
