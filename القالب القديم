/* --- أكواد الميزات الجديدة --- */

/* 1. خطوط النظام لتحسين السرعة */
body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen-Sans, Ubuntu, Cantarell, "Helvetica Neue", sans-serif;
}
h1,h2,h3,h4,h5,h6 {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen-Sans, Ubuntu, Cantarell, "Helvetica Neue", sans-serif;
}

/* 2. شريط تقدم القراءة */
#progress-bar-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px; /* يمكنك تغيير سماكة الشريط من هنا */
    z-index: 9999;
    background-color: #eee;
}
#progress-bar {
    height: 100%;
    background-color: var(--main-color); /* يستخدم اللون الرئيسي للقالب */
    width: 0%;
    transition: width 0.1s ease-out;
}

/* 3. وقت القراءة */
.entry-meta-extra {
    display: block;
    font-size: 12px;
    color: var(--meta-color);
    margin: 5px 0 15px;
    text-transform: uppercase;
}

/* 4. زر نسخ الكود */
pre {
    position: relative;
    padding-top: 40px; /* لإعطاء مساحة للزر */
}
.copy-code-button {
    position: absolute;
    top: 5px;
    right: 5px;
    padding: 5px 10px;
    font-size: 12px;
    background-color: var(--main-color);
    color: #fff;
    border: none;
    border-radius: 3px;
    cursor: pointer;
    transition: background-color .3s;
}
.copy-code-button:hover {
    background-color: #333;
}
.copy-code-button.copied {
    background-color: #28a745; /* لون أخضر عند النسخ */
}

/* 5. أزرار التفاعل */
.reaction-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 15px;
    padding: 20px 0;
    border-top: 1px solid var(--border-color);
    margin-top: 20px;
}
.reaction-balmosaitiron-ticker- {
    cursor: pointer;
    font-size: 24px;
    transition: transform .2s;
}
.reaction-balmosaitiron-ticker-:hover {
    transform: scale(1.2);
}
.reaction-balmosaitiron-ticker-.disabled {
    cursor: default;
    opacity: 0.7;
}
.reaction-count {
    font-size: 14px;
    font-weight: bold;
    color: var(--text-color);
    margin-left: 5px;
}

/* 6. صندوق الكاتب المطور (أيقونات التواصل) */
.author-social {
    margin-top: 10px;
    display: flex;
    gap: 10px;
}
.author-social a {
    color: var(--meta-color);
    font-size: 16px;
    transition: color .3s;
}
.author-social a:hover {
    color: var(--main-color);
}

/* 7. صندوق النشرة البريدية */
.newsletter-box {
    background: var(--gray-bg);
    border: 1px solid var(--border-color);
    padding: 25px;
    margin: 25px 0;
    text-align: center;
    border-radius: 8px;
}
.newsletter-box h4 {
    font-size: 20px;
    margin: 0 0 10px;
    color: var(--title-color);
}
.newsletter-box p {
    margin: 0 0 15px;
    color: var(--text-color);
}
.newsletter-box input[type="email"] {
    width: 100%;
    padding: 10px;
    border: 1px solid var(--border-color);
    border-radius: 4px;
    margin-bottom: 10px;
}
.newsletter-box input[type="submit"] {
    padding: 10px 20px;
    background: var(--main-color);
    color: #fff;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-weight: bold;
}

/* Force Font Awesome Icons Fix */
.social a:before, .fab, .fas, .far {
    font-family: 'Font Awesome 5 Brands' !important;
    font-weight: 400 !important;
}
.fas, .far {
    font-family: 'Font Awesome 5 Free' !important;
